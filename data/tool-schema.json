{
  "version": 1,
  "title": "AI-Dekrov tool record",
  "properties": {
    "id": { "type": "string", "required": true, "pattern": "kebab-case", "description": "Stable kebab-case identifier" },
    "name": { "type": "string", "required": true, "description": "Official tool name" },
    "category": { "type": "string", "required": true, "enum": ["coding-agents", "orchestration", "chat-llm", "research", "audio", "dev-tools", "hosting", "other"] },
    "description": { "type": "string", "description": "Short factual description" },
    "bestFor": { "type": "array", "items": { "type": "string" }, "description": "Specific tasks or audiences the tool fits best" },
    "strengths": { "type": "array", "items": { "type": "string" }, "description": "Factual strengths or differentiators" },
    "gettingStarted": { "type": "array", "items": { "type": "string" }, "description": "Verified first-use steps, one step per item" },
    "usageNotes": { "type": "array", "items": { "type": "string" }, "description": "Verified usage notes, key workflows, menus, limits, or requirements" },
    "url": { "type": "string", "required": true, "format": "uri", "description": "Official public URL" },
    "domain": { "type": "string", "description": "Website domain without protocol" },
    "favicon": { "type": "string", "format": "uri", "description": "Public favicon or logo URL" },
    "platforms": { "type": "array", "items": { "enum": ["web", "desktop", "mobile", "browser-extension", "cli", "vscode", "api"] } },
    "pricing": { "type": "string", "enum": ["free", "freemium", "paid", "usage-based"], "allowEmpty": true },
    "priceDetails": { "type": "string", "description": "Optional specific price or billing terms" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "install": { "type": "string", "description": "Verified installation command" },
    "start": { "type": "string", "description": "Verified start command" },
    "commands": { "type": "array", "items": { "type": "object", "properties": { "label": "string", "command": "string" } } },
    "models": { "type": "array", "items": { "type": "string" }, "description": "Officially supported AI model names or model families. Do not include providers, runtimes, marketplaces, compatibility statements, or vague model-count descriptions." },
    "github": { "type": "string", "format": "uri", "description": "Official GitHub repository URL" },
    "docs": { "type": "string", "format": "uri", "description": "Official documentation URL" },
    "addedAt": { "type": "string", "format": "date", "description": "Date the public record was added" },
    "updatedAt": { "type": "string", "format": "date", "description": "Date the public record was last updated" },
    "lastVerifiedAt": { "type": "string", "format": "date", "allowEmpty": true, "description": "Last public verification date" },
    "sources": { "type": "array", "items": { "type": "string", "format": "uri" }, "description": "Public source URLs used to verify the record" }
  },
  "generated": ["addedAt", "updatedAt", "lastVerifiedAt", "sources"]
}
