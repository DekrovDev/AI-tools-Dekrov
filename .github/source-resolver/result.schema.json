{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findingId",
    "status",
    "reason",
    "proposal"
  ],
  "properties": {
    "findingId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposal",
        "skip"
      ]
    },
    "reason": {
      "type": "string"
    },
    "proposal": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "findingId",
            "replacementUrl",
            "reason",
            "contentVerified",
            "officialOwnershipVerified",
            "evidence"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "findingId": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "replacementUrl": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://",
              "maxLength": 4096
            },
            "reason": {
              "type": "string",
              "minLength": 20,
              "maxLength": 2000
            },
            "contentVerified": {
              "const": true
            },
            "officialOwnershipVerified": {
              "const": true
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "url",
                  "explanation"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "format": "uri",
                    "pattern": "^https://",
                    "maxLength": 4096
                  },
                  "explanation": {
                    "type": "string",
                    "minLength": 20,
                    "maxLength": 2000
                  }
                }
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
